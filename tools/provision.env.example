# Morning Board Provisioning Configuration
# 
# Copy this file to provision.env and fill in your details.
# DO NOT commit provision.env with real credentials!

WIFI_SSID=YourWiFiNetworkName
WIFI_PASS=YourWiFiPassword
FEED_URL=https://example.com/path/to/your/feed.json

# Example with the included sample feed (served locally):
# FEED_URL=https://gist.githubusercontent.com/username/abc123/raw/feed.json
